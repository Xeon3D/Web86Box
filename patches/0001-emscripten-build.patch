diff --git a/src/network/CMakeLists.txt b/src/network/CMakeLists.txt
index fff50d184..29e158218 100644
--- a/src/network/CMakeLists.txt
+++ b/src/network/CMakeLists.txt
@@ -41,9 +41,14 @@ list(APPEND net_sources
     utils/getline.c
 )
 
+if(EMSCRIPTEN)
+    # No libslirp on the web; the platform layer supplies the SLiRP driver.
+    list(REMOVE_ITEM net_sources net_slirp.c)
+else()
 find_package(PkgConfig REQUIRED)
 pkg_check_modules(SLIRP REQUIRED IMPORTED_TARGET slirp)
 target_link_libraries(86Box PkgConfig::SLIRP)
+endif()
 
 if(WIN32)
     target_link_libraries(PkgConfig::SLIRP INTERFACE wsock32 ws2_32 iphlpapi)
