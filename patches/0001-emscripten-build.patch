diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index af1b92eb0..f6a06c46f 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -178,20 +178,30 @@ if(APPLE)
     endif()
 endif()
 
+if(EMSCRIPTEN)
+    # Emscripten ports provide freetype, libpng and zlib.
+    add_compile_options(-sUSE_FREETYPE=1 -sUSE_LIBPNG=1 -sUSE_ZLIB=1)
+    target_link_options(86Box PRIVATE -sUSE_FREETYPE=1 -sUSE_LIBPNG=1 -sUSE_ZLIB=1)
+    # Stub headers (sndfile, ...) for libraries unavailable on the web.
+    include_directories(BEFORE ${WEB86BOX_PLATFORM_DIR}/include)
+else()
 find_package(Freetype REQUIRED)
 include_directories(${FREETYPE_INCLUDE_DIRS})
 if(FREETYPE_INCLUDE_DIR_ft2build)
     include_directories(${FREETYPE_INCLUDE_DIR_ft2build})
 endif()
+endif()
 if(APPLE)
     # Freetype is dynamically loaded by the emulator, however, we link it
     # on macOS so it gets copied to the bundle by the installation process
     target_link_libraries(86Box Freetype::Freetype)
 endif()
 
+if(NOT EMSCRIPTEN)
 find_package(PNG REQUIRED)
 include_directories(${PNG_INCLUDE_DIRS})
 target_link_libraries(86Box PNG::PNG)
+endif()
 
 configure_file(include/86box/version.h.in include/86box/version.h @ONLY)
 include_directories(${CMAKE_CURRENT_BINARY_DIR}/include)
@@ -310,7 +320,9 @@ endif()
 
 add_subdirectory(osd)
 
-if (QT)
+if (EMSCRIPTEN AND WEB86BOX_PLATFORM_DIR)
+    add_subdirectory(${WEB86BOX_PLATFORM_DIR} web)
+elseif (QT)
     add_subdirectory(qt)
 else()
     add_compile_definitions(USE_SDL_UI)
